---
import Base from '../layouts/Base.astro';
import ui from '../data/interface.json';
import { sitePath } from '../lib/urls';
---

<Base title={ui.notFoundTitle}>
  <section class="section">
    <p class="eyebrow">404</p>
    <h1>{ui.notFoundHeading}</h1>
    <p>{ui.notFoundText}</p>
    <a class="button" href={sitePath("/")}>
      {ui.homeLink}
    </a>
  </section>
</Base>
