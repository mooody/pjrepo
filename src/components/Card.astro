---
import Image from './Image.astro';
import { formatDate } from '../lib/content';
const { entry, href } = Astro.props;
---

<article class="card">
  <a class="card-image" href={href} tabindex="-1" aria-hidden="true">
    <Image id={entry.data.image} decorative />
  </a>
  <div class="card-body">
    <div class="eyebrow">
      {entry.data.example ? 'Exempel' : entry.data.category || 'Kunskap'}
      {entry.data.date && ` · ${formatDate(entry.data.date)}`}
    </div>
    <h3>
      <a href={href}>{entry.data.title}</a>
    </h3>
    <p>{entry.data.description}</p>
    <a class="text-link" href={href}>
      Läs mer <span aria-hidden="true">↗</span>
      <span class="sr-only"> om {entry.data.title}</span>
    </a>
  </div>
</article>
