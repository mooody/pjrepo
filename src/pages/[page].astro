---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import settings from '../data/settings.json';
import { published } from '../lib/content';
export async function getStaticPaths() {
  return (await published('pages')).map((entry) => ({
    params: { page: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <article class="section detail">
    <p class="eyebrow">{settings.name}</p>
    <h1>{entry.data.title}</h1>
    <p class="lead">{entry.data.description}</p>
    <div class="prose">
      <Content />
    </div>
    {entry.id === 'kontakt' && (
      <div class="contact">
        {settings.email ? (
          <a class="button" href={`mailto:${settings.email}`}>
            {settings.email}
          </a>
        ) : (
          <p class="notice">Kontaktuppgifter kommer när verksamheten öppnar.</p>
        )}
        {settings.social.map((link: { label: string; url: string }) => (
          <p>
            <a href={link.url}>{link.label}</a>
          </p>
        ))}
      </div>
    )}
  </article>
</Base>
