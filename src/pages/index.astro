---
import Base from '../layouts/Base.astro';
import Image from '../components/Image.astro';
import Card from '../components/Card.astro';
import home from '../data/home.json';
import { published, hrefFor } from '../lib/content';
import { sitePath } from '../lib/urls';
const chili = (await published('chilies')).filter(e => home.featuredChilies.includes(e.id));
---
<Base>
  <section class="hero section">
    <div>
      <p class="eyebrow">{home.eyebrow}</p>
      <h1>{home.title}</h1>
      <p class="lead">{home.intro}</p>
      <div class="actions">
        <a class="button" href={sitePath(home.primaryHref)}>{home.primaryLabel} <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={sitePath(home.secondaryHref)}>{home.secondaryLabel}</a>
      </div>
      <p class="hero-note">{home.heroNote}</p>
    </div>
    <Image id={home.heroImage} alt={home.heroAlt} hero variant="full" />
  </section>
  <section class="section philosophy">
    <p class="eyebrow">{home.philosophyEyebrow}</p>
    <h2>{home.philosophyTitle}</h2>
    <p class="lead">{home.philosophy}</p>
    <a class="text-link" href={sitePath(home.philosophyHref)}>{home.philosophyLink} ↗</a>
  </section>
  <section class="section">
    <div class="section-heading"><div><p class="eyebrow">{home.chiliEyebrow}</p><h2>{home.chiliTitle}</h2><p>{home.chiliText}</p></div><a class="text-link" href={sitePath('/chilisorter/')}>{home.chiliLink} ↗</a></div>
    <div class="grid">{chili.map(entry => <Card entry={entry} href={hrefFor('chilies', entry.id)} />)}</div>
  </section>
  <section class="section processing tinted">
    <Image id={home.processingImage} />
    <div><h2>{home.processingTitle}</h2><p class="lead">{home.processingText}</p><a class="button" href={sitePath('/foradla/')}>{home.processingLink} ↗</a></div>
  </section>

<section class="section"><a class="text-link" href={sitePath("/chilibilder/")}>Se fler bilder från chilin ↗</a></section>
</Base>
