---
import { render } from 'astro:content';
import ArticleTools from '../components/ArticleTools.astro';
import Base from '../layouts/Base.astro';
import settings from '../data/settings.json';
import Image from '../components/Image.astro';
import ui from '../data/interface.json';
import { published } from '../lib/content';
export async function getStaticPaths() {
  return (await published('pages')).map((entry) => ({
    params: { page: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const breadcrumbs = [
  { name: 'Startsida', href: '/' },
  ...(['chilifortplantning', 'chiliarter'].includes(entry.id) ? [{ name: 'Chili', href: '/chili/' }] : []),
  { name: entry.data.title, href: `/${entry.id}/` },
];
---

<Base title={entry.data.title} description={entry.data.description} breadcrumbs={breadcrumbs} printable>
  <ArticleTools />
  <article class="section detail">
    <p class="eyebrow">{settings.name}</p>
    <h1>{entry.data.title}</h1>
    <p class="lead">{entry.data.description}</p>
    <Image id={entry.data.image} alt={entry.data.imageAlt} />
    <div class="prose">
      <Content />
    </div>
    {entry.data.gallery.length > 0 && <div class="gallery">{entry.data.gallery.map(item => <Image id={item.image} alt={item.alt} />)}</div>}
    {entry.id === 'kontakt' && (
      <div class="contact">
        {settings.email ? (
          <a class="button" href={`mailto:${settings.email}`}>
            {settings.email}
          </a>
        ) : (
          <p class="notice">{ui.contactPending}</p>
        )}
        {settings.social.map((link: { label: string; url: string }) => (
          <p>
            <a href={link.url}>{link.label}</a>
          </p>
        ))}
      </div>
    )}
  </article>
  <ArticleTools placement="footer" />
</Base>
