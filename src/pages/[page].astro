---
import { render } from 'astro:content';
import ArticleTools from '../components/ArticleTools.astro';
import Base from '../layouts/Base.astro';
import settings from '../data/settings.json';
import Image from '../components/Image.astro';
import ui from '../data/interface.json';
import { published } from '../lib/content';
import { sitePath } from '../lib/urls';
export async function getStaticPaths() {
  return (await published('pages')).map((entry) => ({
    params: { page: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const harvestTopics = [
  {
    eyebrow: 'Syrning och smak',
    title: 'Fermentering',
    description: 'Hur mjölksyrabakterier förändrar grönsaker och chili – och vad som krävs för en kontrollerad process.',
    href: '/fermentering/',
  },
  {
    eyebrow: 'Kommande guide',
    title: 'Frysning och torkning',
    description: 'Olika sätt att bevara råvaror och vad som händer med kvalitet, smak och användning.',
    href: null,
  },
  {
    eyebrow: 'Kommande guide',
    title: 'Inläggning och konservering',
    description: 'Skillnaden mellan syra, socker, salt, värmebehandling och andra metoder.',
    href: null,
  },
  {
    eyebrow: 'Kommande guide',
    title: 'Från skörd till kök',
    description: 'Sortering, förvaring och idéer för att använda små och stora skördar.',
    href: null,
  },
];
const breadcrumbs = [
  { name: 'Startsida', href: '/' },
  ...(['chilifortplantning', 'chiliarter'].includes(entry.id) ? [{ name: 'Chili', href: '/chili/' }] : []),
  ...(entry.id === 'fermentering' ? [{ name: 'Ta vara på skörden', href: '/foradla/' }] : []),
  { name: entry.data.title, href: `/${entry.id}/` },
];
---

<Base title={entry.data.title} description={entry.data.description} breadcrumbs={breadcrumbs} printable>
  <ArticleTools />
  <article class="section detail">
    <p class="eyebrow">{settings.name}</p>
    <h1>{entry.data.title}</h1>
    <p class="lead">{entry.data.description}</p>
    <Image id={entry.data.image} alt={entry.data.imageAlt} />
    <div class="prose">
      <Content />
    </div>
    {entry.id === 'foradla' && (
      <div class="grid topic-grid" aria-label="Guider om skörd och mathantverk">
        {harvestTopics.map((topic) => topic.href ? (
          <a class="card" href={sitePath(topic.href)}>
            <div class="card-body">
              <p class="eyebrow">{topic.eyebrow}</p>
              <h2>{topic.title}</h2>
              <p>{topic.description}</p>
              <p class="text-link">Läs artikeln →</p>
            </div>
          </a>
        ) : (
          <div class="card">
            <div class="card-body">
              <p class="eyebrow">{topic.eyebrow}</p>
              <h2>{topic.title}</h2>
              <p>{topic.description}</p>
            </div>
          </div>
        ))}
      </div>
    )}
    {entry.data.gallery.length > 0 && <div class="gallery">{entry.data.gallery.map(item => <Image id={item.image} alt={item.alt} />)}</div>}
    {entry.id === 'kontakt' && (
      <div class="contact">
        {settings.email ? (
          <a class="button" href={`mailto:${settings.email}`}>
            {settings.email}
          </a>
        ) : (
          <p class="notice">{ui.contactPending}</p>
        )}
        {settings.social.map((link: { label: string; url: string }) => (
          <p>
            <a href={link.url}>{link.label}</a>
          </p>
        ))}
      </div>
    )}
  </article>
  <ArticleTools placement="footer" />
</Base>
