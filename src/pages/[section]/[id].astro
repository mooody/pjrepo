---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ui from '../../data/interface.json';
import { sitePath } from '../../lib/urls';
import Image from '../../components/Image.astro';
import { sections, published, formatDate } from '../../lib/content';
export async function getStaticPaths() {
  const lists = await Promise.all(
    sections.map(async (section) =>
      (await published(section.collection)).map((entry) => ({
        params: { section: section.path, id: entry.id },
        props: { section, entry },
      })),
    ),
  );
  return lists.flat();
}
const { section, entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---

<Base title={d.title} description={d.description}>
  <article class="section detail">
    <a class="text-link" href={sitePath(`/${section.path}/`)}>
      ← {section.title}
    </a>
    <header>
      <p class="eyebrow">
        {d.category || section.title}
        {d.date && ` · ${formatDate(d.date)}`}
      </p>
      <h1>{d.title}</h1>
      <p class="lead">{d.description}</p>
      {d.example && (
        <p class="notice">
          {ui.exampleNotice}
        </p>
      )}
    </header>
    <Image id={d.image} alt={d.imageAlt} />
    {(d.species || d.scientificName || d.heatMin !== undefined) && (
      <dl class="facts">
        {d.species && (
          <>
            <dt>Art</dt>
            <dd>
              <i>{d.species}</i>
            </dd>
          </>
        )}
        {d.scientificName && (
          <>
            <dt>{ui.groupLabel}</dt>
            <dd>
              <i>{d.scientificName}</i>
            </dd>
          </>
        )}
        {d.heatMin !== undefined && (
          <>
            <dt>Ungefärlig styrka</dt>
            <dd>
              {d.heatMin.toLocaleString('sv-SE')}–
              {d.heatMax?.toLocaleString('sv-SE')} SHU
            </dd>
          </>
        )}
        {[
          ['Utseende', d.appearance],
          ['Smakprofil', d.flavor],
          ['Ursprung', d.origin],
          ['Växtsätt och odling', d.growth],
        ]
          .filter(([, value]) => value)
          .map(([label, value]) => (
            <>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </>
          ))}
      </dl>
    )}
    {section.collection === 'projects' && (
      <p class="notice">{ui.projectStatusLabel}: {d.projectStatus}</p>
    )}
    {d.heatNote && <p class="notice">{d.heatNote}</p>}
    <div class="prose">
      <Content />
      {d.experiences && (
        <>
          <h2>{ui.experiencesTitle}</h2>
          <p>{d.experiences}</p>
        </>
      )}
    </div>
    {d.gallery.length > 0 && (
      <div class="gallery">
        {d.gallery.map((item) => (
          <Image id={item.image} alt={item.alt} />
        ))}
      </div>
    )}
    {(['observations'].includes(section.collection) || (section.collection === 'articles' && d.evidence !== 'etablerad')) && (
      <aside class="metadata">
        <p>{ui.evidenceLabel}: {d.evidence}. {d.identification && `${ui.identificationLabel}: ${d.identification}.`}</p>
        <p>{ui.observationNotice}</p>
      </aside>
    )}
    {d.sources.length > 0 && (
      <aside class="sources">
        <h2>{ui.sourcesTitle}</h2>
        <ul>
          {d.sources.map((source) => (
            <li>
              <a href={source.url}>{source.title}</a>
            </li>
          ))}
        </ul>
        {d.reviewed && (
          <p>{ui.reviewedLabel}: {formatDate(d.reviewed)}</p>
        )}
      </aside>
    )}
    {d.related.length > 0 && (
      <aside>
        <h2>{ui.relatedTitle}</h2>
        <ul>
          {d.related.map((link) => (
            <li>
              <a href={sitePath(link.href)}>{link.label}</a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </article>
</Base>
