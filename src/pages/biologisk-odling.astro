---
import Base from '../layouts/Base.astro';
import ui from '../data/interface.json';
import { sitePath } from '../lib/urls';
import { sections, published } from '../lib/content';
const featuredIds = ['jord-och-kompost', 'tackodling', 'biologisk-mangfald'];
const methods = await published('methods');
const featuredGuides = featuredIds.flatMap((id) => {
  const guide = methods.find((entry) => entry.id === id);
  return guide ? [guide] : [];
});
const groups = sections.filter((s) =>
  ['beneficials', 'pests', 'methods'].includes(s.collection),
);
---

<Base
  title={ui.biology.title}
  description={ui.biology.description}
  breadcrumbs={[{ name: 'Startsida', href: '/' }, { name: ui.biology.title, href: '/biologisk-odling/' }]}
>
  <section class="section">
    <p class="eyebrow">{ui.biology.eyebrow}</p>
    <h1>{ui.biology.title}</h1>
    <p class="lead narrow">
      {ui.biology.intro}
    </p>

    {featuredGuides.length > 0 && (
      <section aria-labelledby="garden-guides-heading">
        <h2 id="garden-guides-heading">Jord och trädgårdsliv</h2>
        <p class="lead narrow">
          Grunden till en levande trädgård finns både ovan och under jordytan.
          Läs mer om jordens egenskaper, marktäckning och hur du gynnar mångfalden.
        </p>
        <div class="grid">
          {featuredGuides.map((guide) => (
            <article class="topic">
              <h3>
                <a href={sitePath(`/odlingsmetoder/${guide.id}/`)}>{guide.data.title}</a>
              </h3>
              <p>{guide.data.description}</p>
              <a class="text-link" href={sitePath(`/odlingsmetoder/${guide.id}/`)}>
                Läs artikeln ↗
              </a>
            </article>
          ))}
        </div>
      </section>
    )}
    <h2>Fler ämnen att utforska</h2>
    <div class="grid topic-grid">
      {groups.map((group) => (
        <article class="topic">
          <span class="topic-icon" aria-hidden="true">
            ✳
          </span>
          <h2>
            <a href={sitePath(`/${group.path}/`)}>{group.title}</a>
          </h2>
          <p>{group.intro}</p>
          <a class="text-link" href={sitePath(`/${group.path}/`)}>
            {ui.biology.linkLabel} {group.title.toLowerCase()} ↗
          </a>
        </article>
      ))}
    </div>
  </section>
</Base>
