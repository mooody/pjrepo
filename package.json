{
  "name": "tradgardsdrommar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run cms && npm run images && astro dev",
    "check": "astro check",
    "images": "node scripts/images.mjs",
    "cms": "node scripts/cms.mjs",
    "build": "npm run validate && npm run cms && npm run images && astro build && node scripts/base-links.mjs",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm run build && npm test && npm run test:browser",
    "validate": "node scripts/validate.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.8",
    "decap-cms": "3.16.3",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3"
  }
}
