---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { sitePath } from '../../lib/urls';
// Endast katalogens kort använder illustrerade webbetiketter.
// Originaletiketten kommer fortsatt från produktens labelImage på detaljsidan.
const overviewImages: Record<string, string> = {
  "habanero-lemon": "/product-images/habanero-lemon-webbetikett.webp",
  "habanero-chocolate": "/product-images/habanero-chocolate-webbetikett.webp",
  "sotsyrliga-jalapenos": "/product-images/sotsyrliga-jalapenos-webbetikett.webp",
  "tradgardseld": "/product-images/tradgardseld-webbetikett.webp",
  "rod-glod": "/product-images/rod-glod-webbetikett.webp",
  "ghost": "/product-images/ghost-webbetikett.webp",
  "fermenterad-mangosalsa": "/product-images/fermenterad-mangosalsa-webbetikett.webp",
  "tropisk-glod": "/product-images/tropisk-glod-webbetikett.webp",
  "rod-mango": "/product-images/rod-mango-webbetikett.webp"
};
const products = (await getCollection('products', ({data}) => !data.draft && data.year === 2026))
  .sort((a,b)=>a.data.order-b.data.order || a.data.title.localeCompare(b.data.title, 'sv'));
---
<Base title="Produkter 2026 – chilisås och marmelad" description="Upptäck Trädgårdsdrömmars förädlade chiliprodukter från 2026. Se chilisåser, marmelader, produktbilder och etiketter för varje sats." breadcrumbs={[{ name: "Startsida", href: "/" }, { name: "Produkter 2026", href: "/produkter-2026/" }]}>
  <section class="section products-list">
    <p class="eyebrow">Från odling till förädling</p>
    <h1>Produkter 2026</h1>
    <p class="lead">Här hittar du produkter från årets förädling. Klicka på en etikett för att se produktbilden, hela etiketten och mer information.</p>
    <div class="product-grid">
      {products.map(product => (
        <a class="product-card" href={sitePath('/produkter-2026/' + product.id + '/')}>
          <div class="product-card-label">
            <img src={sitePath(overviewImages[product.id] ?? product.data.labelImage)} alt={'Etikett för ' + product.data.title} loading="lazy" decoding="async" />
          </div>
          <div class="product-card-content">
            <p class="eyebrow">{product.data.category} · {product.data.batch}</p>
            <h2>{product.data.title}</h2>
            <p>{product.data.description}</p>
            <span class="text-link">Visa produkten ↗</span>
          </div>
        </a>
      ))}
    </div>
    <p class="product-disclaimer">Detta är ett produktarkiv. Beställning och betalning finns inte på webbplatsen ännu.</p>
  </section>
</Base>
