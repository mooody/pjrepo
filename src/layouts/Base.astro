---
import settings from '../data/settings.json';
import ui from '../data/interface.json';
import imageExports from '../../web-images/index.json';
import { sitePath } from '../lib/urls';
import '../styles/global.css';
const { title, description = settings.description, breadcrumbs = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const colors = settings.colors;
const share = imageExports.images.find(i => i.id === settings.sharingImage)?.variants.sharing.at(-1);
const variables = `--earth:${colors.earth};--olive:${colors.olive};--sand:${colors.sand};--terracotta:${colors.terracotta};--sage:${colors.sage}`;
const absoluteUrl = (href: string) => new URL(sitePath(href), Astro.site).href;
// WebSite identifies the preferred name on the homepage; breadcrumb data follows existing routes.
const structuredData = [
  ...(Astro.url.pathname === sitePath('/') ? [{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: settings.name,
    url: absoluteUrl('/'),
    inLanguage: 'sv-SE',
    description: settings.description,
  }] : []),
  ...(breadcrumbs.length > 1 ? [{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((item: { name: string; href: string }, i: number) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: item.name,
      item: absoluteUrl(item.href),
    })),
  }] : []),
];
---

<!doctype html>
<html lang="sv" style={variables}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${settings.name}` : settings.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title || settings.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:locale" content="sv_SE" />
    <meta name="twitter:card" content={share ? "summary_large_image" : "summary"} />
    {structuredData.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
    ))}
    {share && <>
      <meta property="og:image" content={new URL(sitePath(`/media/${share.file}`), Astro.site).href} />
      <meta property="og:image:width" content={String(share.width)} />
      <meta property="og:image:height" content={String(share.height)} />
      <meta property="og:image:alt" content={settings.description} />
    </>}
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content={colors.earth} />
    <link rel="icon" href={sitePath("/favicon.svg")} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">
      {ui.skip}
    </a>
    <header class="site-header">
      <a class="brand" href={sitePath("/")}>
        {settings.logo ? (
          <img src={settings.logo} alt="" width="42" height="42" />
        ) : (
          <span class="brand-mark" aria-hidden="true">
            ✳
          </span>
        )}
        <span>
          {settings.name}
          <small>{settings.tagline}</small>
        </span>
      </a>
      <button
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="navigation"
      >
        {ui.menu} <span aria-hidden="true">☰</span>
      </button>
      <nav id="navigation" aria-label="Huvudmeny">
        {settings.navigation.map((item) => (
          <a
            href={sitePath(item.href)}
            aria-current={
              Astro.url.pathname.startsWith(sitePath(item.href)) ||
              (item.href === '/biologiskt-vaxtskydd/' &&
                ['/nyttodjur/', '/skadedjur/'].some((path) => Astro.url.pathname.startsWith(sitePath(path))))
                ? 'page' : undefined
            }
          >
            {item.label}
          </a>
        ))}
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div>
        <a class="footer-brand" href={sitePath("/")}>
          {settings.name}
        </a>
        <p>{settings.description}</p>
      </div>
      <div>
        <a href={sitePath("/kontakt/")}>{ui.contactLabel}</a>
        <a href={sitePath("/bildvillkor/")}>{ui.imageTermsLabel}</a>
        <a href={sitePath("/admin/")}>{ui.adminLabel}</a>
        <p>
          © {new Date().getFullYear()} {settings.name}
        </p>
      </div>
    </footer>
    <script>
      document.documentElement.classList.add('js');
      const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#navigation');
      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') !== 'true';
        button.setAttribute('aria-expanded', String(open));
        nav?.classList.toggle('open', open);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          button?.setAttribute('aria-expanded', 'false');
          nav?.classList.remove('open');
          button?.focus();
        }
      });
    </script>
  </body>
</html>
