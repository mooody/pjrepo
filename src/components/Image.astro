---
import manifest from '../data/images.json';
import exports from '../../web-images/index.json';
import ui from '../data/interface.json';
import { sitePath } from '../lib/urls';
const { id, alt, hero = false, decorative = false, variant = hero ? 'hero' : 'full' } = Astro.props;
const record = manifest.images.find(image => image.id === id);
const output = exports.images.find(image => image.id === id);
const variants = output?.variants[variant as keyof typeof output.variants] || output?.variants.full;
const largest = variants?.at(-1);
---
{record && largest ? (
  <figure>
    <img src={sitePath(`/media/${largest.file}`)}
      srcset={variants?.map(v => `${sitePath(`/media/${v.file}`)} ${v.width}w`).join(', ')}
      sizes={variant === 'card' ? '(max-width: 700px) 88vw, (max-width: 1050px) 30vw, 400px' : hero ? '(max-width: 700px) 88vw, 560px' : '(max-width: 900px) 88vw, 800px'}
      alt={decorative ? '' : alt || record.alt} loading={hero ? 'eager' : 'lazy'}
      fetchpriority={hero ? 'high' : 'auto'} decoding="async" width={largest.width} height={largest.height} />
    {!decorative && (record.caption || record.ownership === 'third-party') && <figcaption>{record.caption}{record.ownership === 'third-party' && <> Foto: {record.photographer}. {record.license}</>}</figcaption>}
  </figure>
) : !decorative ? <p class="image-pending">{ui.placeholder}</p> : null}
