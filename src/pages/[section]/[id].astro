---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ui from '../../data/interface.json';
import { sitePath } from '../../lib/urls';
import Image from '../../components/Image.astro';
import { sections, published, formatDate } from '../../lib/content';
export async function getStaticPaths() {
  const lists = await Promise.all(
    sections.map(async (section) =>
      (await published(section.collection)).map((entry) => ({
        params: { section: section.path, id: entry.id },
        props: { section, entry },
      })),
    ),
  );
  return lists.flat();
}
const { section, entry } = Astro.props;
const d = entry.data;
const isChili = section.collection === 'chilies';
const directGardenGuides = section.collection === 'methods' && [
  'jord-och-kompost', 'tackodling', 'biologisk-mangfald',
  'jordens-sma-arbetare', 'kompost', 'tackodling-genom-aret',
  'forbattra-jorden', 'kopejord', 'efter-skorden',
  'ateranvand-krukjord', 'blomning-genom-sasongen',
].includes(entry.id);
const { Content } = await render(entry);
const isAnimal = ['beneficials', 'pests'].includes(section.collection);
const isProtectionGuide = section.collection === 'methods' && entry.id === 'att-odla-med-naturen';
const parent = isAnimal || isProtectionGuide ? [{ name: 'Biologiskt växtskydd', href: '/biologiskt-vaxtskydd/' }]
  : section.collection === 'chilies' ? [{ name: 'Chili', href: '/chili/' }]
  : ['beneficials', 'pests', 'methods'].includes(section.collection)
    ? [{ name: 'Livet i trädgården', href: '/biologisk-odling/' }] : [];
const breadcrumbs = [
  { name: 'Startsida', href: '/' }, ...parent,
  ...(!directGardenGuides && !isProtectionGuide ? [{ name: section.title, href: `/${section.path}/` }] : []),
  { name: d.title, href: `/${section.path}/${entry.id}/` },
];
---

<Base title={d.title} description={d.description} breadcrumbs={breadcrumbs}>
  <article class="section detail">
    {(isAnimal || isProtectionGuide) && (
      <nav class="article-breadcrumbs" aria-label="Brödsmulor">
        <a href={sitePath('/')}>Startsida</a>
        <span aria-hidden="true">›</span>
        <a href={sitePath('/biologiskt-vaxtskydd/')}>Biologiskt växtskydd</a>
        <span aria-hidden="true">›</span>
        {isAnimal && <>
          <a href={sitePath(`/${section.path}/`)}>{section.title}</a>
          <span aria-hidden="true">›</span>
        </>}
        <span aria-current="page">{d.title}</span>
      </nav>
    )}
    {directGardenGuides && (
      <nav class="article-breadcrumbs" aria-label="Brödsmulor">
        <a href={sitePath('/')}>Startsida</a>
        <span aria-hidden="true">›</span>
        <a href={sitePath('/biologisk-odling/')}>Livet i trädgården</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{d.title}</span>
      </nav>
    )}
    <a class="text-link" href={sitePath(isProtectionGuide ? '/biologiskt-vaxtskydd/' : directGardenGuides ? '/biologisk-odling/' : `/${section.path}/`)}>
      ← {isProtectionGuide ? 'Biologiskt växtskydd' : directGardenGuides ? 'Livet i trädgården' : section.title}
    </a>
    <header>
      <p class="eyebrow">
        {d.category || section.title}
        {d.date && ` · ${formatDate(d.date)}`}
      </p>
      <h1>{d.title}</h1>
      <p class="lead">{d.description}</p>
      {d.example && (
        <p class="notice">
          {ui.exampleNotice}
        </p>
      )}
    </header>
    <Image id={d.image} alt={d.imageAlt} />
    {(d.species || d.scientificName || d.heatMin !== undefined) && (
      <dl class="facts">
        {d.species && (
          <>
            <dt>Art</dt>
            <dd>
              <i>{d.species}</i>
            </dd>
          </>
        )}
        {d.scientificName && (
          <>
            <dt>{ui.groupLabel}</dt>
            <dd>
              <i>{d.scientificName}</i>
            </dd>
          </>
        )}
        {(isChili || d.heatMin !== undefined) && (
          <>
            <dt>Ungefärlig styrka</dt>
            <dd>
              {d.heatMin !== undefined && d.heatMax !== undefined
                ? `Cirka ${d.heatMin.toLocaleString('sv-SE')}–${d.heatMax.toLocaleString('sv-SE')} SHU`
                : 'SHU-intervall saknas'}
            </dd>
          </>
        )}
        {[
          ['Utseende', d.appearance],
          ...(!isChili ? [
            ['Smakprofil', d.flavor],
            ['Ursprung', d.origin],
            ['Växtsätt och odling', d.growth],
          ] : []),
        ]
          .filter(([, value]) => value)
          .map(([label, value]) => (
            <>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </>
          ))}
      </dl>
    )}
    {section.collection === 'projects' && (
      <p class="notice">{ui.projectStatusLabel}: {d.projectStatus}</p>
    )}
    {d.heatNote && <p class="notice">{d.heatNote}</p>}
    <div class="prose">
      <Content />
      {d.experiences && (
        <>
          <h2>{ui.experiencesTitle}</h2>
          <p>{d.experiences}</p>
        </>
      )}
    </div>
    {d.gallery.length > 0 && (
      <div class="gallery">
        {d.gallery.map((item) => (
          <Image id={item.image} alt={item.alt} />
        ))}
      </div>
    )}
    {d.sources.length > 0 && (
      <aside class="sources">
        <h2>{ui.sourcesTitle}</h2>
        <ul>
          {d.sources.map((source) => (
            <li>
              <a href={source.url}>{source.title}</a>
            </li>
          ))}
        </ul>
        {d.reviewed && (
          <p>{ui.reviewedLabel}: {formatDate(d.reviewed)}</p>
        )}
      </aside>
    )}
    {d.related.length > 0 && (
      <aside>
        <h2>{ui.relatedTitle}</h2>
        <ul>
          {d.related.map((link) => (
            <li>
              <a href={sitePath(link.href)}>{link.label}</a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </article>
</Base>
