---
import Base from '../../layouts/Base.astro';
import ui from '../../data/interface.json';
import Card from '../../components/Card.astro';
import { sections, published, hrefFor } from '../../lib/content';
export async function getStaticPaths() {
  return Promise.all(
    sections.map(async (section) => ({
      params: { section: section.path },
      props: { section, entries: await published(section.collection) },
    })),
  );
}
const { section, entries } = Astro.props;
const tags = [...new Set(entries.flatMap((e) => e.data.tags))].sort();
const isAnimal = ['beneficials', 'pests'].includes(section.collection);
const isBeneficials = section.collection === 'beneficials';
const naturalBeneficials = entries.filter((e) => e.data.category !== 'Nyttodjur – biologisk bekämpning');
const purchasedBeneficials = entries.filter((e) => e.data.category === 'Nyttodjur – biologisk bekämpning');
const parent = isAnimal ? [{ name: 'Biologiskt växtskydd', href: '/biologiskt-vaxtskydd/' }]
  : section.collection === 'chilies' ? [{ name: 'Chili', href: '/chili/' }]
  : ['beneficials', 'pests', 'methods'].includes(section.collection)
    ? [{ name: 'Livet i trädgården', href: '/biologisk-odling/' }] : [];
const breadcrumbs = [
  { name: 'Startsida', href: '/' }, ...parent,
  { name: section.title, href: `/${section.path}/` },
];
---

<Base title={section.title} description={section.intro} breadcrumbs={breadcrumbs}>
  <section class="section" data-result-label={ui.resultLabel}>
    <p class="eyebrow">{ui.searchEyebrow}</p>
    <h1>{section.title}</h1>
    <p class="lead narrow">{section.intro}</p>
    <div class="filters">
      <label>
        {ui.searchLabel}
        <input
          type="search"
          id="search"
          placeholder={ui.searchPlaceholder}
        />
      </label>
      <label>
        {ui.filterLabel}
        <select id="filter">
          <option value="">{ui.allTopics}</option>
          {tags.map((tag) => (
            <option value={tag}>{tag}</option>
          ))}
        </select>
      </label>
      <p id="count" role="status" aria-live="polite">
        {entries.length} {ui.resultLabel}
      </p>
    </div>
    <div id="results" class:list={{ grid: !isBeneficials }}>
      {isBeneficials ? (
        <>
          <section class="animal-group" id="naturliga-nyttodjur" aria-labelledby="naturliga-heading">
            <h2 id="naturliga-heading">Naturliga nyttodjur</h2>
            <p>Arter och grupper som kan finnas i odlingen och gynnas av blomning, skydd och en varierad livsmiljö.</p>
            <div class="grid">
              {naturalBeneficials.map((entry) => (
                <div class="search-entry"
                  data-search={`${entry.data.title} ${entry.data.description} ${entry.data.species} ${entry.data.tags.join(' ')}`.toLocaleLowerCase('sv')}
                  data-tags={JSON.stringify(entry.data.tags)}
                >
                  <Card entry={entry} href={hrefFor(section.collection, entry.id)} />
                </div>
              ))}
            </div>
          </section>
          <section class="animal-group" id="biologisk-bekampning" aria-labelledby="bekampning-heading">
            <h2 id="bekampning-heading">Nyttodjur för biologisk bekämpning</h2>
            <p>Arter som används vid planerad utsättning, exempelvis i växthus. Rätt skadegörare, stadium och odlingsmiljö avgör vad som kan fungera.</p>
            <div class="grid">
              {purchasedBeneficials.map((entry) => (
                <div class="search-entry"
                  data-search={`${entry.data.title} ${entry.data.description} ${entry.data.species} ${entry.data.tags.join(' ')}`.toLocaleLowerCase('sv')}
                  data-tags={JSON.stringify(entry.data.tags)}
                >
                  <Card entry={entry} href={hrefFor(section.collection, entry.id)} />
                </div>
              ))}
            </div>
          </section>
        </>
      ) : entries.map((entry) => (
        <div class="search-entry"
          data-search={`${entry.data.title} ${entry.data.description} ${entry.data.species} ${entry.data.tags.join(' ')}`.toLocaleLowerCase('sv')}
          data-tags={JSON.stringify(entry.data.tags)}
        >
          <Card entry={entry} href={hrefFor(section.collection, entry.id)} />
        </div>
      ))}
    </div>
    <p id="empty" hidden>
      {ui.emptySearch}
    </p>
    {entries.length === 0 && (
      <p>{ui.emptySection}</p>
    )}
  </section>
</Base>
<script>
  const input = document.querySelector<HTMLInputElement>('#search');
  const select = document.querySelector<HTMLSelectElement>('#filter');
  const entries = [...document.querySelectorAll<HTMLElement>('.search-entry')];
  function update() {
    let count = 0;
    for (const entry of entries) {
      const tags = JSON.parse(entry.dataset.tags || '[]') as string[];
      const show =
        (entry.dataset.search || '').includes(
          (input?.value || '').trim().toLocaleLowerCase('sv'),
        ) &&
        (!select?.value || tags.includes(select.value));
      entry.hidden = !show;
      if (show) count++;
    }
    for (const group of document.querySelectorAll<HTMLElement>('.animal-group')) {
      group.hidden = !group.querySelector('.search-entry:not([hidden])');
    }
    const counter = document.querySelector('#count');
    if (counter) counter.textContent = `${count} ${document.querySelector<HTMLElement>('[data-result-label]')?.dataset.resultLabel || ''}`;
    const empty = document.querySelector<HTMLElement>('#empty');
    if (empty) empty.hidden = count !== 0;
  }
  input?.addEventListener('input', update);
  select?.addEventListener('change', update);
</script>
