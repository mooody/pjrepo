---
import Base from '../layouts/Base.astro';
import ui from '../data/interface.json';
import { sitePath } from '../lib/urls';
import { sections } from '../lib/content';
const groups = sections.filter((s) =>
  ['beneficials', 'pests', 'methods'].includes(s.collection),
);
---

<Base
  title={ui.biology.title}
  description={ui.biology.description}
  breadcrumbs={[{ name: 'Startsida', href: '/' }, { name: ui.biology.title, href: '/biologisk-odling/' }]}
>
  <section class="section">
    <p class="eyebrow">{ui.biology.eyebrow}</p>
    <h1>{ui.biology.title}</h1>
    <p class="lead narrow">
      {ui.biology.intro}
    </p>
    <div class="grid topic-grid">
      {groups.map((group) => (
        <article class="topic">
          <span class="topic-icon" aria-hidden="true">
            ✳
          </span>
          <h2>
            <a href={sitePath(`/${group.path}/`)}>{group.title}</a>
          </h2>
          <p>{group.intro}</p>
          <a class="text-link" href={sitePath(`/${group.path}/`)}>
            {ui.biology.linkLabel} {group.title.toLowerCase()} ↗
          </a>
        </article>
      ))}
    </div>
  </section>
</Base>
